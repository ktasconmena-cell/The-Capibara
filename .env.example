# Copia este archivo como .env y pega ahi tu token de Discord
DISCORD_BOT_TOKEN=tu_token_aqui
GUILD_ID=1555720952342511686
CHANNEL_NAME=【⛓️】ɴᴏ-ʜᴀʙʟᴀʀ
# Si lo rellenas, tiene prioridad sobre CHANNEL_NAME (mas fiable)
CHANNEL_ID=1558483859996278914
# Minimos de antiguedad para que un mensaje sea borrado
DELETE_AFTER_MINUTES=30
# Minutos de aislamiento (timeout) para quien escriba
TIMEOUT_MINUTES=60
# 1 = los mensajes fijados del canal no se borran
KEEP_PINNED=1
# --- Publicar streams ---
# 1 = activa el comando /publicar-stream en el canal de streams
STREAM_ENABLE=1
# Rol con permiso para publicar streams
STREAM_ROLE_NAME=× Streamer
# Canal donde se publica (se busca por fragmento del nombre)
STREAM_CHANNEL_NAME=streams
